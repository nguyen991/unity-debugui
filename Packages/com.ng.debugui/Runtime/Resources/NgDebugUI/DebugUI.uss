/* Ng Debug UI — fixed theme. Sizes are in panel px; the panel uses ConstantPhysicalSize at
   96 reference DPI, so 32px ≈ 8.5mm: comfortable for fingers, compact for a mouse. */

.ngdbg-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 14px;
    color: rgb(225, 225, 230);
}

/* ---------- Window ---------- */

/* Width/height come from DebugUI.Width / DebugUI.Height (inline %, anchored top-right). */
.ngdbg-window {
    position: absolute;
    top: 0;
    right: 0;
    background-color: rgba(22, 22, 28, 0.92);
    border-bottom-left-radius: 6px;
    padding: 4px;
}

.ngdbg-tabbar {
    flex-shrink: 0;
    max-height: 48px;
    margin-bottom: 4px;
}

.ngdbg-tabbar .unity-scroll-view__content-container {
    flex-direction: row;
}

.ngdbg-tab {
    min-height: 32px;
    padding: 0 14px;
    margin: 0 2px 0 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(48, 48, 58);
    color: rgb(190, 190, 200);
    -unity-font-style: bold;
}

.ngdbg-tab--selected {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
}

.ngdbg-content {
    flex-grow: 1;
}


.ngdbg-panel {
    padding: 0 4px 8px 4px;
}

/* ---------- Toggle button ---------- */

.ngdbg-toggle {
    position: absolute;
    right: 8px;
    bottom: 4px;
    width: 48px;
    height: 48px;
    margin: 0;
    border-radius: 24px;
    border-width: 0;
    background-color: rgba(70, 110, 200, 0.85);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

/* DebugUI.ButtonPosition corners (bottom-right is the default above). */
.ngdbg-toggle--top-left {
    top: 4px;
    left: 8px;
    right: auto;
    bottom: auto;
}

.ngdbg-toggle--top-right {
    top: 4px;
    right: 8px;
    bottom: auto;
}

.ngdbg-toggle--bottom-left {
    left: 8px;
    right: auto;
}

/* Button size (DebugUI.ButtonSize) and the space kept free around it (beside the tabs in a top corner,
   below the content in a bottom corner) are set from code. */

/* ---------- Controls ---------- */

.ngdbg-root Label {
    color: rgb(225, 225, 230);
}

.ngdbg-text {
    min-height: 32px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.ngdbg-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 32px;
}

.ngdbg-value {
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.ngdbg-button {
    min-height: 32px;
    margin: 2px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(58, 58, 70);
    color: rgb(235, 235, 240);
}

.ngdbg-button:hover {
    background-color: rgb(72, 72, 88);
}

.ngdbg-button:active {
    background-color: rgb(70, 110, 200);
}

/* Buttons with a custom color (Button(text, onClick, color)): feedback via opacity. */
.ngdbg-button--colored:hover {
    opacity: 0.85;
}

.ngdbg-button--colored:active {
    opacity: 0.6;
}

.ngdbg-field,
.ngdbg-slider {
    min-height: 32px;
    margin: 2px 0;
    align-items: center;
}

/* Toggles: a row of toggle buttons that wraps to the next line when full. */
.ngdbg-toggles {
    min-height: 32px;
    margin: 2px 0;
    align-items: flex-start;
}

.ngdbg-toggles > .unity-base-field__label {
    min-height: 28px;
    -unity-text-align: middle-left;
}

.ngdbg-toggles .unity-button-group {
    flex-wrap: wrap;
    flex-shrink: 1;
    flex-grow: 1;
}

/* .ngdbg-root + Unity's button-group classes: more specific than the default theme's rules. */
.ngdbg-root .ngdbg-toggles Button.unity-button-group__button {
    min-height: 28px;
    margin: 1px;
    padding: 0 10px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(58, 58, 70);
    color: rgb(235, 235, 240);
}

.ngdbg-root .ngdbg-toggles Button.unity-button-group__button:hover {
    background-color: rgb(72, 72, 88);
}

/* Selected: the same accent as the selected tab. */
.ngdbg-root .ngdbg-toggles Button.unity-button-group__button:checked {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
}

.ngdbg-root .unity-base-field__label {
    min-width: 110px;
    color: rgb(200, 200, 210);
}

.ngdbg-root .unity-base-text-field__input {
    min-height: 28px;
    background-color: rgb(40, 40, 50);
    color: rgb(235, 235, 240);
    border-color: rgb(70, 70, 85);
}

.ngdbg-slider .unity-base-slider__input {
    min-height: 28px;
}

.ngdbg-slider .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-radius: 9px;
}

.ngdbg-slider .unity-slider__input-field,
.ngdbg-slider .unity-slider-int__input-field {
    width: 64px;
}

.ngdbg-root .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
}

.ngdbg-foldout {
    margin-top: 2px;
}

.ngdbg-foldout > .unity-foldout__toggle {
    min-height: 32px;
    margin: 0;
}

.ngdbg-foldout > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
}

/* ---------- Layouts ---------- */

.ngdbg-horizontal {
    flex-direction: row;
}

.ngdbg-horizontal > * {
    flex-grow: 1;
    flex-basis: 0;
}

/* Each() inside Horizontal: items side by side, sharing the row like direct children. */
.ngdbg-horizontal > .ngdbg-each {
    flex-direction: row;
}

.ngdbg-horizontal > .ngdbg-each > * {
    flex-grow: 1;
    flex-basis: 0;
}

/* Line(): horizontal rule in a column, vertical rule in a row. */
.ngdbg-line {
    height: 1px;
    flex-shrink: 0;
    margin: 6px 0;
    background-color: rgba(255, 255, 255, 0.15);
}

.ngdbg-horizontal > .ngdbg-line {
    width: 1px;
    height: auto;
    flex-grow: 0;
    flex-basis: auto;
    margin: 4px 6px;
}

.ngdbg-error,
.ngdbg-root .ngdbg-error Label,
.ngdbg-root Label.ngdbg-error {
    color: rgb(255, 90, 90);
}

/* ---------- Phone width: stack slider label above its track so the track stays draggable ---------- */

.ngdbg-narrow .ngdbg-slider {
    flex-direction: column;
    align-items: stretch;
}

/* The default theme sizes a horizontal slider's input row to the slider's full height. Once the
   label sits above it that pushes the row (and its number box) out over the next control. */
.ngdbg-narrow .ngdbg-slider > .unity-base-slider__input {
    height: auto;
}

.ngdbg-narrow .ngdbg-slider > .unity-base-field__label {
    min-width: 0;
    margin-bottom: 2px;
}

.ngdbg-narrow .ngdbg-toggles {
    flex-direction: column;
    align-items: stretch;
}

.ngdbg-narrow .ngdbg-toggles > .unity-base-field__label {
    min-width: 0;
    min-height: 0;
    margin-bottom: 2px;
}

.ngdbg-narrow .unity-base-field__label {
    min-width: 90px;
}

/* ---------- Built-in log panel (DebugUI.LogPanel) ---------- */

.ngdbg-log-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.ngdbg-log-filter {
    min-height: 32px;
    margin-right: 12px;
}

.ngdbg-log-toolbar > .ngdbg-button {
    margin-left: auto;
    min-width: 72px;
}

.ngdbg-log-search {
    min-height: 32px;
    margin: 2px 0 4px 0;
}

.ngdbg-log-list {
    height: 320px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
}

.ngdbg-log-row {
    height: 100%;
    padding: 0 6px;
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The default selection color is light grey, unreadable with the light row text. */
.ngdbg-log-list .unity-collection-view__item--selected {
    background-color: rgb(70, 110, 200);
}

.ngdbg-root .ngdbg-log-row--warning {
    color: rgb(255, 205, 90);
}

.ngdbg-root .ngdbg-log-row--error {
    color: rgb(255, 105, 105);
}

.ngdbg-log-details {
    margin-top: 4px;
    padding: 6px;
    font-size: 12px;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 4px;
}
